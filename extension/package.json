{
  "name": "prompt-enhancement",
  "displayName": "PromptClarity",
  "description": "AI-powered prompt enhancement popup for VS Code Chat - detects prompts and suggests improvements",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Copilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension/extension.js",
  "contributes": {
    "configuration": {
      "title": "PromptClarity",
      "properties": {
        "promptClarity.performanceMode": {
          "type": "string",
          "enum": [
            "fast",
            "balanced",
            "quality"
          ],
          "default": "fast",
          "description": "Controls the trade-off between speed and rewrite quality."
        },
        "promptClarity.keepModelsWarm": {
          "type": "boolean",
          "default": true,
          "description": "Keeps local Ollama models in memory between rewrites."
        },
        "promptClarity.intervention": {
          "type": "string",
          "enum": [
            "strict",
            "normal",
            "polished"
          ],
          "default": "normal",
          "description": "Controls how much wording may change while preserving intent, facts, language and uncertainty."
        },
        "promptClarity.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "pt-PT"
          ],
          "default": "auto",
          "description": "Preferred output language."
        }
      }
    },
    "commands": [
      {
        "command": "prompt-enhancement.togglePopup",
        "title": "PromptClarity: Enhance Prompt",
        "description": "Analyze selected text and show an improved version in a popup"
      },
      {
        "command": "prompt-enhancement.analyzeAndCopy",
        "title": "PromptClarity: Analyze & Copy",
        "description": "Analyze the last text and copy the improved version"
      },
      {
        "command": "prompt-enhancement.showDiagnostics",
        "title": "PromptClarity: Show Diagnostics",
        "description": "Show local API, Ollama and last rewrite diagnostics without prompt contents"
      }
    ],
    "keybindings": [
      {
        "command": "prompt-enhancement.togglePopup",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorHasSelection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "prompt-enhancement.togglePopup",
          "group": "1_modification",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.0"
  },
  "publisher": "promptclarity",
  "repository": {
    "type": "git",
    "url": "https://github.com/FranciscoSousaSilveira/PromptClarity"
  },
  "bugs": {
    "url": "https://github.com/FranciscoSousaSilveira/PromptClarity/issues"
  },
  "homepage": "https://github.com/FranciscoSousaSilveira/PromptClarity",
  "keywords": [
    "prompt",
    "ai",
    "enhancement",
    "copilot",
    "chat"
  ]
}
