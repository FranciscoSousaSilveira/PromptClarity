{
  "name": "prompt-clarity-desktop",
  "private": true,
  "version": "0.2.0",
  "productName": "PromptClarity",
  "description": "Local desktop prompt enhancer - private, offline, yours",
  "author": "PromptClarity",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && node scripts/start.mjs",
    "start": "node scripts/start.mjs",
    "package": "npm run build && electron-builder --win nsis",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "com.promptclarity.desktop",
    "productName": "PromptClarity",
    "asar": true,
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "resources/api/api/**/*"
    ],
    "directories": {
      "output": "../../release/desktop"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "FranciscoSousaSilveira",
      "repo": "Grammarly-Prompts"
    }
  }
}
