{
  "name": "prompt-grammarly",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "build:chrome": "node build-extension.js",
    "build:vscode": "npm --prefix extension run build",
    "desktop:install": "npm --prefix apps/desktop-app install",
    "desktop:build": "npm --prefix apps/desktop-app run build",
    "desktop:typecheck": "npm --prefix apps/desktop-app run typecheck",
    "desktop:dev": "npm --prefix apps/desktop-app run dev",
    "desktop": "node scripts/start-desktop-stack.mjs",
    "model:pull": "npm run model:pull:fast && npm run model:pull:balanced && npm run model:pull:quality",
    "model:pull:fast": "node scripts/ollama-cli.mjs pull qwen2.5:0.5b",
    "model:pull:balanced": "node scripts/ollama-cli.mjs pull gemma3:1b",
    "model:pull:quality": "node scripts/ollama-cli.mjs pull qwen2.5:3b",
    "start": "next start -H 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "package:chrome": "node scripts/package-chrome.mjs",
    "package:vscode": "npm --prefix extension run package",
    "package:desktop": "node scripts/package-desktop.mjs",
    "package:all": "npm run package:chrome && npm run package:vscode && npm run package:desktop",
    "diagnostics": "node scripts/diagnostics.mjs",
    "benchmark:models": "node scripts/benchmark-models.mjs",
    "release:sync": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "next": "^15.5.19",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^15.5.19",
    "@playwright/test": "^1.61.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitest/coverage-v8": "^4.1.9",
    "archiver": "^8.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "prettier": "^3.9.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}
